#!/bin/bash

# Create a desktop launcher for a web app: prompts for a name and URL, pulls
# the site's icon automatically (apple-touch-icon, /apple-touch-icon.png, then
# Google's favicon service), and writes a .desktop entry so the app shows up in
# the Noctalia launcher. Chromium's --app= window strips the browser chrome for
# a borderless app look.

set -e

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
DESKTOP_DIR="$HOME/.local/share/applications"
LAUNCHER_SCRIPT="$(cd "$(dirname "$0")" && pwd)/qs-webapp-launch"

safe_icon_name() {
  printf '%s\n' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'
}

require_plain_name() {
  if [[ $1 == */* ]]; then
    echo "App name cannot contain '/': $1" >&2
    exit 1
  fi
  if [[ -z $1 ]]; then
    echo "App name cannot be empty." >&2
    exit 1
  fi
}

# Chromium --app= treats javascript:, file:, and data: as a document to run.
# Prefix schemeless input with https and refuse anything that is not http(s).
normalize_webapp_url() {
  local url=$1
  if [[ ! $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    url="https://$url"
  fi
  printf '%s' "$url"
}

require_http_url() {
  local url=$1
  if [[ $url =~ [[:space:]] ]]; then
    echo "Error: web app URL must not contain whitespace." >&2
    exit 1
  fi
  if [[ ! ${url,,} =~ ^https?:// ]]; then
    echo "Error: web app URL must be http or https." >&2
    exit 1
  fi
}

download_icon() {
  curl -fsSL --max-time 10 -o "$2" "$1" 2>/dev/null &&
    [[ -s $2 && $(file -b --mime-type "$2") == image/* ]]
}

fetch_site_icon() {
  local site_url="$1" dest="$2"
  local origin page icon_url
  origin=$(sed -E 's|^(https?://[^/]+).*|\1|' <<<"$site_url")

  # Prefer the site's own high-res icon (apple-touch-icon), then the well-known
  # path, then Google's favicon service as a last resort.
  page=$(curl -fsSL --max-time 5 "$site_url" 2>/dev/null | head -c 100000 | tr '\n' ' ')
  icon_url=$(grep -oiE "<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>" <<<"$page" |
    grep -oiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//")

  case $icon_url in
  http://* | https://*) ;;
  //*) icon_url="https:$icon_url" ;;
  /*) icon_url="$origin$icon_url" ;;
  ?*) icon_url="$origin/$icon_url" ;;
  esac

  { [[ -n $icon_url ]] && download_icon "$icon_url" "$dest"; } ||
    download_icon "$origin/apple-touch-icon.png" "$dest" ||
    download_icon "https://www.google.com/s2/favicons?domain=${site_url}&sz=256" "$dest"
}

# Freedesktop Desktop Entry "string" escaping: a raw newline would open a new
# key, and every Exec argument that is not the URL is literal text, so escape
# backslash first, then tab/CR/LF and a leading space.
desktop_string_escape() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//$'\t'/\\t}
  value=${value//$'\r'/\\r}
  value=${value//$'\n'/\\n}
  [[ $value == " "* ]] && value="\\s${value# }"
  printf '%s' "$value"
}

# One quoted Exec argument per the freedesktop Exec spec: inside quotes
# " ` $ \ take a backslash and a literal % becomes %%.
desktop_exec_arg() {
  printf '"%s"' "$(printf '%s' "$1" \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/`/\\`/g' -e 's/\$/\\$/g' -e 's/%/%%/g')"
}

INTERACTIVE_MODE=false
if (( $# < 3 )); then
  INTERACTIVE_MODE=true
  echo -e "\nLet's create a web app you can start from the launcher.\n"
  read -rp "Name> " APP_NAME
  require_plain_name "$APP_NAME"
  read -rp "URL> " APP_URL
  APP_URL=$(normalize_webapp_url "$APP_URL")
  require_http_url "$APP_URL"
  ICON_REF=""
else
  APP_NAME="$1"
  APP_URL=$(normalize_webapp_url "$2")
  require_http_url "$APP_URL"
  ICON_REF="$3"
  EXTRA_ARGS="${4:-}" # Optional extra chromium args, appended to Exec
fi
require_plain_name "$APP_NAME"

mkdir -p "$ICON_DIR" "$DESKTOP_DIR"
ICON_VALUE=$(safe_icon_name "$APP_NAME")

if [[ -z $ICON_REF ]]; then
  if fetch_site_icon "$APP_URL" "$ICON_DIR/$ICON_VALUE.png"; then
    gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
  elif [[ $INTERACTIVE_MODE == "true" ]]; then
    read -rp "Icon URL/name> " ICON_REF
    if [[ -z $ICON_REF ]]; then
      echo "No icon provided; the app will use the fallback icon." >&2
    fi
  else
    echo "Error: failed to fetch a site icon; pass an icon URL or name explicitly." >&2
    exit 1
  fi
fi

if [[ -n $ICON_REF ]]; then
  if [[ $ICON_REF =~ ^https?:// ]]; then
    download_icon "$ICON_REF" "$ICON_DIR/$ICON_VALUE.png" \
      || { echo "Error: failed to download icon." >&2; exit 1; }
    gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
  elif [[ -f $ICON_REF ]]; then
    ext="${ICON_REF##*.}"
    [[ $ext == "$ICON_REF" ]] && ext="png"
    cp "$ICON_REF" "$ICON_DIR/$ICON_VALUE.$ext"
    gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
  else
    ICON_VALUE="$ICON_REF" # Existing icon name in the theme
  fi
fi

DESKTOP_FILE="$DESKTOP_DIR/$APP_NAME.desktop"
exec_line="$LAUNCHER_SCRIPT $(desktop_exec_arg "$APP_URL")${EXTRA_ARGS:+ $EXTRA_ARGS}"

{
  printf '[Desktop Entry]\nVersion=1.0\nName=%s\nComment=%s\nExec=%s\n' \
    "$(desktop_string_escape "$APP_NAME")" \
    "$(desktop_string_escape "$APP_NAME")" \
    "$(desktop_string_escape "$exec_line")"
  printf 'Terminal=false\nType=Application\nIcon=%s\nStartupNotify=true\n' \
    "$(desktop_string_escape "$ICON_VALUE")"
} >"$DESKTOP_FILE"

chmod +x "$DESKTOP_FILE"
update-desktop-database "$DESKTOP_DIR" &>/dev/null || true

echo -e "\n$APP_NAME installed. Launch it from the launcher (SUPER + SPACE)."